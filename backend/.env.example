# Alpha Analyser API
ANALYSER_API_KEY=alphafx
PORT=8090
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Admin — synced from backend/admin.env on each deploy (git pull → deploy-ec2.sh)
# Use quotes if password contains #  e.g. ADMIN_PASSWORD="##Linux##1"
ADMIN_EMAIL=admin@alphafx.org
ADMIN_PASSWORD="change-me-admin-password"

# SQLite auth DB (copy this file for backup)
ANALYSER_DB_PATH=analyser.db
AUTH_TOKEN_DAYS=30

# MT5 Windows VPS — upstream candles + SMC (server-to-server only)
MT5_VPS_URL=http://13.42.76.172:8080
MT5_API_KEY=alphafx

# Telegram signal channel (bot must be admin of the channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx
TELEGRAM_BOT_USERNAME=YourSignalsBot
