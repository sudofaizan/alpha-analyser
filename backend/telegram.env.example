# Copy values to telegram.env (or add to /opt/alpha-analyser/backend/.env on EC2)
# Bot must be ADMIN of the private signal channel (posts signals + invite links).
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHI...
TELEGRAM_CHANNEL_ID=-1001234567890
TELEGRAM_BOT_USERNAME=AlphaAnalyserBot

# Optional — direct add by @username using YOUR Telegram account (no /start, no invite tap).
# 1) Create app at https://my.telegram.org/apps
# 2) Run once on EC2: sudo .venv/bin/python setup_telegram_user.py
# 3) Your account must be channel admin with "Add members" permission.
TELEGRAM_USER_API_ID=
TELEGRAM_USER_API_HASH=
# Use absolute path if session was created under ec2-user (gunicorn runs as root — ~ breaks)
# TELEGRAM_USER_SESSION=/home/ec2-user/telegram_user
TELEGRAM_USER_SESSION=.telegram_user
